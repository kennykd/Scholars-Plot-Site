generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  user
}

enum ProjectStatus {
  active
  completed
  archived
}

enum ProjectUserRole {
  owner
  moderator
  collaborator
  member
}

enum TaskStatus {
  Completed
  In_Progress @map("In Progress")
  Pending
}

enum SessionTimerStatus {
  idle
  running
  paused
  completed
}

enum ReminderIntervalType {
  minutes 
  hours
  days
  weeks
  months  
  fixed   
  custom  
}

enum MessageRole {
  user
  assistant
}

enum ActionStatus {
  none
  pending
  confirmed
  dismissed
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

model User {
  user_id           String   @id
  analytics_id      Int?     @unique
  user_name         String
  user_email        String   @unique
  avatar_url        String?
  user_role         UserRole @default(user)
  push_subscription String? 
  user_last_login   DateTime
  user_created_at   DateTime @default(now())

  // AI Profile data from dev-ai
  ai_behavior_profile   Json?
  ai_profile_updated_at DateTime?

  // Relations
  analytics            Analytics?          @relation
  project_members      ProjectUser[]
  task_users           TaskUser[]
  study_session_user   StudySessionUser[]
  user_formula_weights UserFormulaWeights?
  user_availability    UserAvailability[]  
  overload_warnings    OverloadWarning[]   
  chat_conversations   ChatConversation[] 

  @@map("user")
}

model UserFormulaWeights {
  id               Int       @id @default(autoincrement())
  user_id          String    @unique // Kept as String to avoid relation crashes
  w_impact         Decimal   @default(3.0) @db.Decimal(4, 2)
  w_confidence     Decimal   @default(1.0) @db.Decimal(4, 2) // Saved from main
  w_ease           Decimal   @default(2.0) @db.Decimal(4, 2)
  w_urgency        Decimal   @default(4.0) @db.Decimal(4, 2)
  last_adapted_at  DateTime? 
  tasks_since_last Int       @default(0)   
  updated_at       DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_formula_weights")
}

model UserAvailability {
  id          Int     @id @default(autoincrement())
  user_id     String
  day_of_week Int     
  start_time  String  
  end_time    String  
  is_active   Boolean @default(true)

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  
  @@map("user_availability")
}

model Project {
  project_id          Int           @id @default(autoincrement())
  project_name        String
  project_description String?       @db.Text
  project_deadline    DateTime
  project_status      ProjectStatus @default(active)
  project_priority    Decimal       @db.Decimal(2, 1)
  project_created_at  DateTime      @default(now())

  project_user ProjectUser[]
  tasks        Task[]

  @@map("project")
}

model ProjectUser {
  project_id        Int
  user_id           String
  user_joined_at    DateTime        @default(now())
  project_user_role ProjectUserRole

  project Project @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [user_id])

  @@id([project_id, user_id])
  @@map("project_user")
}

model Task {
  task_id           Int        @id @default(autoincrement())
  project_id        Int?
  task_name         String
  task_description  String?    @db.Text
  task_deadline     DateTime
  task_priority     Decimal    @db.Decimal(2, 1)
  task_status       TaskStatus @default(Pending)
  task_completed_at DateTime?
  task_created_at   DateTime   @default(now())

  estimated_minutes    Int?
  confidence_score     Int?      
  grade_weight_percent Decimal?  @db.Decimal(5, 2) 
  ai_priority_score    Int?      
  ai_analyzed_at       DateTime? 

  project        Project?       @relation(fields: [project_id], references: [project_id], onDelete: SetNull)
  task_users     TaskUser[]
  study_session_user StudySessionUser[]
  task_reminders TaskReminder[]
  attachments    Attachment[]

  @@map("task")
}

model TaskUser {
  task_id     Int
  user_id     String
  assigned_at DateTime @default(now())

  task Task @relation(fields: [task_id], references: [task_id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [user_id])

  @@id([task_id, user_id])
  @@map("task_user")
}

model Attachment {
  attachment_id          Int      @id @default(autoincrement())
  task_id                Int?
  file_name              String
  file_path              String
  file_type              String
  attachment_uploaded_at DateTime @default(now())

  task               Task?              @relation(fields: [task_id], references: [task_id], onDelete: SetNull)
  study_session_user StudySessionUser[]

  @@map("attachment")
}

model StudySession {
  study_session_id                Int      @id @default(autoincrement())
  study_session_name              String
  study_session_description       String?  @db.Text
  focus_minutes                   Int      @default(25)
  break_minutes                   Int      @default(5)
  total_pomodoros                 Int      @default(2)
  total_minutes                   Int      @default(60)
  study_session_scheduled_at      DateTime
  study_session_created_at        DateTime @default(now())
  checklist_json                  Json?
  
  // Kept inline configurations from main
  study_session_reminder_enabled Boolean  @default(true)
  study_session_remind_at_minutes Int[]    @default([])

  study_session_user      StudySessionUser[]
  study_session_reminders StudySessionReminder[] // Kept relational engine from dev-ai

  @@map("study_session")
}

model StudySessionUser {
  study_session_id  Int
  user_id           String
  task_id           Int?
  attachment_id     Int?
  started_at        DateTime?
  joined_at         DateTime           @default(now())
  current_time      Int                @default(0)
  status            SessionTimerStatus @default(idle)
  completed_at      DateTime?
  actual_duration   Int?

  study_session StudySession @relation(fields: [study_session_id], references: [study_session_id])
  user          User         @relation(fields: [user_id], references: [user_id])
  task          Task?        @relation(fields: [task_id], references: [task_id])
  attachment    Attachment?  @relation(fields: [attachment_id], references: [attachment_id])

  @@id([study_session_id, user_id])
  @@map("study_session_user")
}

model StudySessionReminder {
  reminder_id         Int                  @id @default(autoincrement())
  study_session_id    Int
  interval_type       ReminderIntervalType
  interval_value      Int?
  remind_at           DateTime
  is_active           Boolean              @default(true)
  reminder_created_at DateTime             @default(now())

  study_session StudySession @relation(fields: [study_session_id], references: [study_session_id])

  @@map("study_session_reminder")
}

model TaskReminder {
  reminder_id         Int                  @id @default(autoincrement())
  task_id             Int
  interval_type       ReminderIntervalType
  interval_value      Int?
  remind_at           DateTime
  is_active           Boolean              @default(true)
  reminder_created_at DateTime             @default(now())

  task   Task    @relation(fields: [task_id], references: [task_id])

  @@map("task_reminder")
}

model OverloadWarning {
  id          Int      @id @default(autoincrement())
  user_id     String
  week_start  DateTime
  warnings    Json
  detected_at DateTime @default(now())
  is_read     Boolean  @default(false)

  user User @relation(fields: [user_id], references: [user_id])

  @@map("overload_warning")
}

model ChatConversation {
  id         Int           @id @default(autoincrement())
  user_id    String
  title      String?
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  user     User          @relation(fields: [user_id], references: [user_id])
  messages ChatMessage[]

  @@map("chat_conversation")
}

model ChatMessage {
  id              Int          @id @default(autoincrement())
  conversation_id Int
  role            MessageRole
  text_content    String       @db.Text
  structured_json Json?
  action_status   ActionStatus @default(none)
  created_at      DateTime     @default(now())

  conversation ChatConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("chat_message")
}

model Analytics {
  analytics_id            Int       @id @default(autoincrement())
  user_id                 String    @unique
  
  tasks_completed_early   String
  tasks_completed_on_time String
  tasks_completed_late    String
  tasks_pending           String
  total_tasks_completed   String
  total_focus_minutes     String
  streak                  String
  last_completion_date    DateTime?

  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("analytics")
}